{
  "name": "plantilla-visor-react",
  "version": "0.0.1",
  "description": "",
  "main": "./dist/main.js",
  "engines": {
    "npm": ">=10.0.0 <11.0.0",
    "node": ">=20.0.0 <23.0.0"
  },
  "scripts": {
    "test": "npm run lint && jest --runInBand --passWithNoTests",
    "start": "webpack serve --env dev",
    "build": "npm test && webpack --env prod",
    "stats": "webpack --env prod --json > stats.json",
    "storybook": "storybook dev -p 6006",
    "storybook-test": "test-storybook --browsers firefox chromium --junit",
    "storybook-test:ci": "npm run storybook-build && npx concurrently -k -s first -n \"SB,TEST\" -c \"magenta,blue\" \"npx http-server storybook-static --port 6007 --silent\" \"npx wait-on tcp:127.0.0.1:6007 && npm run storybook-test -- --url http://localhost:6007\"",
    "storybook-build": "storybook build",
    "deploy": "npm run build && gh-pages -d dist",
    "lint": "npm run lint:js && npm run lint:i18n",
    "lint:js": "eslint src",
    "lint:i18n": "eslint --fix --format node_modules/eslint-plugin-i18n-json/formatter.js src/i18n/*.json",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geomatico/plantilla-visor-react.git"
  },
  "author": "Geomatico <info@geomatico.es>",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/geomatico/plantilla-visor-react/issues"
  },
  "homepage": "https://labs.geomatico.es/plantilla-visor-react",
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.36.0",
    "@geomatico/geocomponents": "^5.0.1",
    "@mui/icons-material": "^6.4.1",
    "@mui/material": "^6.4.1",
    "@storybook/addon-docs": "^9.1.7",
    "@storybook/addon-links": "^9.1.7",
    "@storybook/react-vite": "^9.1.7",
    "@storybook/test-runner": "^0.23.0",
    "@types/jest": "^30.0.0",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "concurrently": "^9.2.1",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^7.1.2",
    "dotenv-webpack": "^8.1.1",
    "eslint": "^9.36.0",
    "eslint-plugin-i18n-json": "^4.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-storybook": "9.1.7",
    "exit-on-error-webpack-plugin": "^0.0.2",
    "gh-pages": "^6.3.0",
    "globals": "^16.4.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.4",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "i18next": "^25.5.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "jest": "^30.1.3",
    "jest-junit": "^16.0.0",
    "jsdom": "^27.0.0",
    "pre-commit": "^1.2.2",
    "raw-loader": "^4.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^15.7.3",
    "react-router-dom": "^7.9.1",
    "storybook": "^9.1.7",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.4.4",
    "ts-loader": "^9.5.4",
    "typescript": "5.7",
    "url-loader": "^4.1.1",
    "wait-on": "^9.0.1",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  }
