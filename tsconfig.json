{
  "compilerOptions": {
    "noImplicitAny": true,
    "module": "es2022",
    "jsx": "react-jsx",
    "lib": ["DOM", "ES2020"],
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "target": "es2022",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "src/**/*.stories.ts", "src/**/*.stories.tsx"],
}
